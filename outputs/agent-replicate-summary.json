  "bootstrap": {
   "n_boot": 1000,
   "seed": 0,
   "alpha": 0.05
  },
  "definitions": {
   "pass@k": "mean over tasks of 1 - C(n-c, k)/C(n, k); k>n not estimable",
   "pass^k": "mean over tasks of C(c, k)/C(n, k); k>n not estimable",
   "pass@1": "mean over tasks of c/n (full-credit pass only)",
   "n": "attempts for one task; c = attempts with status 'pass'",
   "as_failure": "timeout/refusal/error count as failures",
   "exclude_nonattest": "timeout/refusal/error attempts are dropped"
  },
  "notes": [
   "attempts are never pooled across tasks; each task contributes its own per-task estimate",
   "k > n is not estimable for that task and is excluded from that point (see n_tasks and estimable)",
   "'pass' means full-credit acceptance; partial credit is not a pass",
   "timeouts, refusals and transport errors are counted as failures in 'as_failure' and dropped in 'exclude_nonattest'"
  ]
 },
 "notes": [
  "verdict = grade_answer(reference, final_answer) recomputed now, so grader drift is visible instead of inherited from the archive",
  "answer_stable compares whitespace-normalised answer strings; a task can be answer-stable and verdict-stable, or neither",
  "turn_stable compares every emitted turn's text and tool arguments byte-for-byte: the strictest form of 'same run'",
  "every replica decodes at temperature 0.0, so this measures reproducibility of one greedy sample, not sampling variance (that needs temperature > 0 and is measured separately on gsm8k)",
  "pass^k is computed over replicate index as the repeat axis (same weights, same seed, temperature 0.0)",
  "single suite, single model, synthetic lab tasks: the Just et al. ceiling is untouched"
 ]
}